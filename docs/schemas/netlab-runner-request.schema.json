{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Netlab runner protocol 1 request",
  "description": "Request shape only. Ownership, registered IDs, capabilities, tokens and bundles require runtime validation. M1 supports status/start/reset/stop/check; solve/probe require M2 capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "action"],
  "properties": {
    "protocol": {"type": "integer", "const": 1},
    "action": {"enum": ["status", "start", "reset", "stop", "check", "solve", "probe"]},
    "request_id": {"$ref": "#/$defs/uuid"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incarnation", "generation"],
      "properties": {
        "incarnation": {"$ref": "#/$defs/uuid"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "target_lesson": {"$ref": "#/$defs/lesson"},
    "lesson": {"$ref": "#/$defs/lesson"},
    "expected_bundle": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "step": {"$ref": "#/$defs/id"},
    "probe": {"$ref": "#/$defs/id"}
  },
  "oneOf": [
    {
      "properties": {"action": {"const": "status"}},
      "propertyNames": {"enum": ["protocol", "action"]}
    },
    {
      "properties": {"action": {"const": "start"}},
      "required": ["request_id", "expected", "target_lesson", "expected_bundle"],
      "propertyNames": {"enum": ["protocol", "action", "request_id", "expected", "target_lesson", "expected_bundle"]}
    },
    {
      "properties": {"action": {"enum": ["reset", "solve"]}},
      "required": ["request_id", "expected", "lesson", "expected_bundle"],
      "propertyNames": {"enum": ["protocol", "action", "request_id", "expected", "lesson", "expected_bundle"]}
    },
    {
      "properties": {"action": {"const": "stop"}},
      "required": ["request_id", "expected", "lesson"],
      "propertyNames": {"enum": ["protocol", "action", "request_id", "expected", "lesson"]}
    },
    {
      "properties": {"action": {"const": "check"}},
      "required": ["request_id", "expected", "lesson", "expected_bundle", "step"],
      "propertyNames": {"enum": ["protocol", "action", "request_id", "expected", "lesson", "expected_bundle", "step"]}
    },
    {
      "properties": {"action": {"const": "probe"}},
      "required": ["request_id", "expected", "lesson", "expected_bundle", "probe"],
      "propertyNames": {"enum": ["protocol", "action", "request_id", "expected", "lesson", "expected_bundle", "probe"]}
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "not": {"pattern": "[\\r\\n]"}
    },
    "lesson": {
      "type": "string",
      "minLength": 3,
      "maxLength": 81,
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}/[a-z0-9][a-z0-9-]{0,39}$",
      "not": {"pattern": "[\\r\\n]"}
    }
  }
}

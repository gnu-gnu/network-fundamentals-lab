          "id": "verify",
          "kind": "task",
          "required": true,
          "title": "목표 달성 확인",
          "goal": "VLAN 10 h1↔h2 통신을 회복하고 VLAN 20 h3 격리를 유지한다.",
          "hints": [
            "관찰 결과를 근거로 원인을 좁혀 보세요.",
            "양 끝의 설정과 왕복 경로를 비교해 보세요.",
            "정상 조건과 실제 상태의 차이를 확인하세요."
          ],
          "check": {
            "all": [
              {
                "node": "h1",
                "argv": [
                  "ping",
                  "-c1",
                  "-W2",
                  "10.3.10.2"

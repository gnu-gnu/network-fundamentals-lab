[Unit]
Description=Netlab WebSocket chat and presence
After=network.target labd.service

[Service]
Type=simple
ExecStart=/opt/netlab-community-venv/bin/python /opt/netlab-admin/community_ws.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/netlab
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
